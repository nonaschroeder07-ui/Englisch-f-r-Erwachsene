  "rule": {
    "title": { "ru": "you are / I'm from …", "de": "you are / I'm from …" },
    "explanation": {
      "ru": "С «я» — am, с «ты/вы» — are: I am, you are. Чтобы сказать, откуда вы: I'm from + страна. Вопрос: Where are you from? — from уходит в конец вопроса.",
      "de": "Ich → am, du/Sie → are: I am, you are. Herkunft: I'm from + Land. Frage: Where are you from? – from steht am Ende."
    },
    "table": [
      ["", "полная форма", "в разговоре", "Deutsch"],
      ["я", "I am from Russia.", "I'm from Russia.", "Ich komme aus Russland."],
      ["ты/вы", "You are from England.", "You're from England.", "Du kommst / Sie kommen aus England."],
      ["вопрос", "Where are you from?", "—", "Woher kommst du / kommen Sie?"]
    ],
    "examples": [
      { "en": "I'm from Germany.", "translation": { "ru": "Я из Германии.", "de": "Ich komme aus Deutschland." } },
      { "en": "You're from England.", "translation": { "ru": "Ты из Англии.", "de": "Du kommst aus England." } },
      { "en": "Where are you from?", "translation": { "ru": "Откуда вы?", "de": "Woher kommen Sie?" } }
    ],
    "germanBridge": { "ru": "В немецком «Ich komme aus…» — с глаголом «приходить». В английском проще: «я есть из…» — I'm from…", "de": "Statt „kommen aus“ sagt man einfach „sein aus“: I'm from…" },
    "commonMistake": {
      "wrong": "From where are you?",
      "right": "Where are you from?",
      "why": { "ru": "В английском from обычно стоит в конце вопроса.", "de": "Im Englischen steht from am Ende der Frage." }
    }
  },

