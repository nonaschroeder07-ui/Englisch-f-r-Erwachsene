  "rule": {
    "title": { "ru": "Вопрос и отрицание с to be", "de": "Frage und Verneinung mit to be" },
    "explanation": {
      "ru": "Вопрос: глагол ставим перед лицом — You are → Are you…? Отрицание: добавляем not после глагола — I'm not, he isn't, they aren't. Короткий ответ: Yes, I am. / No, I'm not.",
      "de": "Frage: Verb nach vorne – You are → Are you…? (wie im Deutschen: Sie sind → Sind Sie?). Verneinung: not nach dem Verb – I'm not, he isn't, they aren't."
    },
    "table": [
      ["утверждение", "вопрос", "отрицание"],
      ["I am Russian.", "Am I …?", "I'm not German."],
      ["She is a teacher.", "Is she a teacher?", "She isn't a teacher."],
      ["You are English.", "Are you English?", "You aren't English."]
    ],
    "examples": [
      { "en": "Are you German? — No, I'm not.", "translation": { "ru": "Вы немка? — Нет.", "de": "Sind Sie Deutsche? – Nein." } },
      { "en": "Is he your teacher? — Yes, he is.", "translation": { "ru": "Он ваш учитель? — Да.", "de": "Ist er Ihr Lehrer? – Ja." } },
      { "en": "She isn't from England.", "translation": { "ru": "Она не из Англии.", "de": "Sie kommt nicht aus England." } }
    ],
    "germanBridge": { "ru": "Вопрос строится как в немецком: Sie sind → Sind Sie? = You are → Are you? Отрицание: nicht = not, но стоит сразу после am/is/are.", "de": "Wie im Deutschen: Sind Sie…? = Are you…?" },
    "commonMistake": {
      "wrong": "You are English?",
      "right": "Are you English?",
      "why": { "ru": "В русском вопрос — только интонацией. В английском меняется порядок слов.", "de": "Im Englischen ändert sich die Wortstellung – wie im Deutschen." }
    }
  },

