  "situation": {
    "context": { "ru": "На курсы пришёл новый ученик. Вы знакомитесь.", "de": "Ein neuer Teilnehmer kommt in den Kurs. Sie lernen sich kennen." },
    "lines": [
      { "speaker": "Nona", "en": "Hi! I'm Nona. How are you?", "translation": { "ru": "Привет! Я Нона. Как дела?", "de": "Hallo! Ich bin Nona. Wie geht's?" } },
