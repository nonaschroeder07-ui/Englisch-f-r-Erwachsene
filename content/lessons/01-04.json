      { "speaker": "Nona", "en": "I'm not German. I'm Russian.", "translation": { "ru": "Я не немка. Я русская.", "de": "Ich bin keine Deutsche. Ich bin Russin." } },
      { "speaker": "Paul", "en": "Nice to meet you, too!", "translation": { "ru": "Мне тоже приятно!", "de": "Freut mich auch!" } }
    ]
  },

