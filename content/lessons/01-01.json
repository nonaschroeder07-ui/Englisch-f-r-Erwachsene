  "rule": {
    "title": { "ru": "I am = «я есть»: I'm Nona", "de": "I am = ich bin: I'm Nona" },
    "explanation": {
      "ru": "По-русски мы говорим «Я Нона» без глагола. В английском глагол нужен всегда: I am Nona. В разговоре его сокращают: I'm Nona. Спросить имя: What's your name? Ответить: My name is … или I'm …",
      "de": "Wie im Deutschen braucht man ein Verb: I am Nona = Ich bin Nona. Kurzform: I'm Nona. Nach dem Namen fragen: What's your name? Antwort: My name is … oder I'm …"
    },
    "table": [
      ["полная форма", "в разговоре", "Deutsch"],
      ["I am Nona.", "I'm Nona.", "Ich bin Nona."],
      ["My name is Tom.", "My name's Tom.", "Ich heiße Tom."],
      ["What is your name?", "What's your name?", "Wie heißt du?"]
    ],
    "examples": [
      { "en": "I'm Nona.", "translation": { "ru": "Я Нона.", "de": "Ich bin Nona." } },
      { "en": "My name is Tom.", "translation": { "ru": "Меня зовут Том.", "de": "Ich heiße Tom." } },
      { "en": "What's your name?", "translation": { "ru": "Как тебя/вас зовут?", "de": "Wie heißt du? / Wie heißen Sie?" } }
    ],
    "germanBridge": { "ru": "I am = ich bin. Логика как в немецком: глагол обязателен.", "de": "I am = ich bin. Das Verb ist Pflicht." },
    "commonMistake": {
      "wrong": "I Nona.",
      "right": "I'm Nona.",
      "why": { "ru": "В русском «быть» пропускают, в английском — никогда.", "de": "Das Verb am darf nie fehlen." }
    }
  },

