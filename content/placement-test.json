{
  "id": "placement-a1",
  "version": 1,
  "title": { "ru": "Тест на уровень", "de": "Einstufungstest" },
  "intro": {
    "ru": "20 коротких вопросов, около 10 минут. Если не знаете ответ — нажмите «Не знаю»: так результат будет честнее. Тест остановится сам, когда уровень станет понятен.",
    "de": "20 kurze Fragen, ca. 10 Minuten. Wenn Sie die Antwort nicht wissen, klicken Sie auf „Weiß ich nicht“ – so wird das Ergebnis genauer. Der Test stoppt automatisch."
  },
  "rules": {
    "durationMin": 10,
    "allowDontKnow": true,
    "dontKnowLabel": { "ru": "Не знаю", "de": "Weiß ich nicht" },
    "dontKnowCountsAsWrong": true,
    "stopAfterWrongInARow": 3,
    "allowedErrorsPerTopic": 1,
    "retakeEveryDays": 30
  },
  "scoring": {
    "description": {
      "ru": "Вопросы идут по темам программы, от 1 до 12. Тема считается пройденной, если все её вопросы были заданы и ошибок не больше allowedErrorsPerTopic (1). Если у темы только один вопрос, он должен быть верным. Уровень = последняя тема, до которой включительно все темы пройдены. Старт = следующая тема. Если тест остановлен после 3 ошибок подряд, оставшиеся вопросы считаются неотвеченными.",
      "de": "Die Fragen folgen den Themen 1–12. Ein Thema gilt als bestanden, wenn höchstens 1 Fehler gemacht wurde (bei nur einer Frage: muss richtig sein). Niveau = letztes bestandenes Thema in Folge. Start = nächstes Thema."
    },
    "results": [
      {
        "id": "from-zero",
        "condition": "masteredTopic == 0",
        "startTopic": 1,
        "message": { "ru": "Начинаем с нуля — с темы 1 «Привет, это я». Отличный старт!", "de": "Wir starten bei null – mit Thema 1 „Hallo, das bin ich“." }
      },
      {
        "id": "from-topic",
        "condition": "1 <= masteredTopic <= 11",
        "startTopic": "masteredTopic + 1",
        "message": { "ru": "Вы уже знаете {knownTopics}. Начинаем с темы {startTopic}. Слова пройденных тем попадут в повторение.", "de": "Sie kennen schon {knownTopics}. Wir starten mit Thema {startTopic}." }
      },
      {
        "id": "a1-done",
        "condition": "masteredTopic == 12",
        "startTopic": null,
        "message": { "ru": "Уровень A1 пройден! Переходим к A2. Для подтверждения можно сдать итоговый тест A1.", "de": "Niveau A1 geschafft! Weiter mit A2." }
      }
    ]
  },
